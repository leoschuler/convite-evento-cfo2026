# Senha do painel interno em /admin. Mínimo 8 caracteres.
# Copie este arquivo para .env.local e troque o valor.
ADMIN_PASSWORD=troque-esta-senha

# Bucket R2 (Cloudflare, S3-compatible) onde ficam as imagens enviadas pelo
# admin (guest_photo/company_logo) e o data/invitations.json em produção.
# Sem essas variáveis a API de upload/cadastro falha com "missing_env_...".
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto
# Domínio público servindo o conteúdo do bucket (sem barra no final).
R2_PUBLIC_BASE_URL=
